-- Construction financial measures

Total Budget =
SUM ( fact_budget[BudgetAmount] )

Total Actual =
SUM ( fact_actuals[ActualAmount] )

Budget Vs Actual Var =
[Total Actual] - [Total Budget]

Budget Vs Actual Var % =
DIVIDE ( [Budget Vs Actual Var], [Total Budget] )

-- Favourable when under budget (construction cost control)
Var Favourable Flag =
IF ( [Budget Vs Actual Var] <= 0, 1, 0 )

Contract Value =
SUM ( dim_job[ContractValue] )

Approved Change Orders =
CALCULATE (
    SUM ( fact_change_orders[ApprovedAmount] ),
    fact_change_orders[Status] = "Approved"
)

Revised Contract Value =
[Contract Value] + [Approved Change Orders]

WIP Earned Revenue =
SUM ( fact_wip[EarnedRevenue] )

WIP Cost To Date =
SUM ( fact_wip[CostToDate] )

WIP Gross Margin =
[WIP Earned Revenue] - [WIP Cost To Date]

WIP Gross Margin % =
DIVIDE ( [WIP Gross Margin], [WIP Earned Revenue] )

Over Under Billing =
SUM ( fact_wip[OverUnderBilling] )

Backlog Remaining =
SUM ( fact_wip[BacklogRemaining] )

AR Invoice Amount =
SUM ( fact_ar_aging[Amount] )

AR Paid =
SUM ( fact_ar_aging[AmountPaid] )

AR Outstanding =
[AR Invoice Amount] - [AR Paid]

AR Current =
CALCULATE ( [AR Outstanding], fact_ar_aging[AgingBucket] = "Current" )

AR 90 Plus =
CALCULATE ( [AR Outstanding], fact_ar_aging[AgingBucket] = "90+" )

Labour Hours =
SUM ( fact_labour[Hours] )

Labour Cost =
SUMX ( fact_labour, fact_labour[Hours] * fact_labour[HourlyRate] )

Labour Cost Per Job =
DIVIDE ( [Labour Cost], DISTINCTCOUNT ( fact_labour[JobId] ) )

-- Time intelligence on actuals (mark dim_date first)
Actuals MTD =
TOTALMTD ( [Total Actual], dim_date[Date] )

Actuals Prior Month =
CALCULATE ( [Total Actual], DATEADD ( dim_date[Date], -1, MONTH ) )

Actuals MoM Var =
[Total Actual] - [Actuals Prior Month]
